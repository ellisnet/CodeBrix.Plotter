<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PicoScope.Scope.Windows</AssemblyName>
    <RootNamespace>PicoScope.Scope.Windows</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- The fast-streaming callback receives int16_t** from the driver -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lets the project compile (not run) on Linux/macOS build hosts -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PicoScope.Scope\PicoScope.Scope.csproj" />
  </ItemGroup>

</Project>
