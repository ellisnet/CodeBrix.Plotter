<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WPF ships net10.0-windows10.0.19041 assets, so the TFM must
         carry (at least) that Windows platform version -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PicoScope</RootNamespace>
    <AssemblyName>PicoScope.Wpf</AssemblyName>
    <!-- The ps2000 driver on a current PicoScope install is 64-bit -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Lets the project compile (not run) on Linux/macOS build hosts -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Helpers\HostHelper.cs" Link="Helpers\HostHelper.cs" />
    <Compile Include="..\Shared\Rendering\ScopeChartRenderer.cs" Link="Rendering\ScopeChartRenderer.cs" />
    <Compile Include="..\Shared\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PicoScope.Scope\PicoScope.Scope.csproj" />
    <ProjectReference Include="..\PicoScope.Scope.Windows\PicoScope.Scope.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.WPF.ApacheLicenseForever" Version="1.0.193.1013" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.151.0" />
  </ItemGroup>

</Project>
