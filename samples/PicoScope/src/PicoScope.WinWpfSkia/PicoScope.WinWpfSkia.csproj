<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views) -->
  <Import Project="..\PicoScope.UI\PicoScope.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\PicoScope.Core\PicoScope.Core.csproj" />
    <!-- The real device, registered in Program.cs; PicoScope.Core only knows the contract -->
    <ProjectReference Include="..\libs\PicoScope.ScopeData.Ps2000\PicoScope.ScopeData.Ps2000.csproj" />
  </ItemGroup>

  <!-- EXACTLY ONE platform head package; all other packages come from PicoScope.Core -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.Wpf.ApacheLicenseForever" Version="1.0.243.226" />
  </ItemGroup>
</Project>
