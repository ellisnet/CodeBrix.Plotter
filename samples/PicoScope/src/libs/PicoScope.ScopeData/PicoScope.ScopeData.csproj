<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PicoScope.ScopeData</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Device-agnostic by construction: this project has no interop, no package
    references and no reference to any UI framework, so it cannot grow a
    dependency on a physical scope or on a platform by accident. The real
    device lives in PicoScope.ScopeData.Ps2000; the chart lives in
    PicoScope.Core.
  -->

</Project>
